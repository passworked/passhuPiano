  ko:
  - "25%\uC640 \uB192\uC740 \uD2F0\uCF13 \uAD6C\uB9E4 \uC608\uC0B0\uC744 \uC0AC\uC6A9\uD558\uBA74,
    \uBC29\uCE58 \uBAA8\uB4DC\uB294 \uB9E4\uBC88 \uBB3B\uC9C0 \uC54A\uACE0 \uAC00\uC6A9
    \uC794\uC561\uC758 \uCD5C\uB300 25%\uAE4C\uC9C0 \uD2F0\uCF13\uC744 \uAD6C\uB9E4\uD558\uBA70
    \uD604\uC7AC \uC124\uC815\uC5D0 \uB530\uB77C \uACC4\uC18D \uAC1C\uBD09\uD569\uB2C8\uB2E4.
    \uC608\uC0B0\uC774 \uB354 \uB0AE\uC740 \uB2E8\uACC4\uB85C \uBC14\uAFB8\uAC70\uB098
    \uB192\uC740 \uD2F0\uCF13 \uAD6C\uB9E4 \uC608\uC0B0\uC744 \uC0AC\uC6A9\uD560
    \uC218 \uC788\uC5B4\uC694."
  - "<size=65%><color=#B8C7B8>\uCD1D \uAC1C\uBD09 \uC218</color></size>  <b>{0}</b>
    <size=60%>\uC7A5</size>"
  - "\uBC29\uCE58 \uAD6C\uB9E4 \uD6C4 VR\uC5D0\uC11C\uB294 \uB808\uBC84\uB97C \uB0B4\uB9AC\uBA74
    \uC2DC\uC791, \uC62C\uB9AC\uBA74 \uC815\uC9C0.\nPC\uB294 \uB808\uBC84 \uD074\uB9AD\uC73C\uB85C
    \uC804\uD658. \uC9C1\uC811 \uD2F0\uCF13\uC744 \uC9D1\uC73C\uBA74 \uBC29\uCE58
    \uC815\uC9C0.\n\uAD6C\uB9E4\uD55C \uD2F0\uCF13\uC744 10\uC7A5 \uC5F4\uBA74 \uD55C
    \uBC88\uC5D0 \uC5F4\uAE30\uB3C4 \uC0AC\uC6A9 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - "<b>Ricorine</b>\n\uCE5C\uAD6C \uC0AC\uC9C4\uC5D0\uC11C\uB9CC \uBCF4\uB358 \uC2E0\uBE44\uD55C
    \uACE0\uC591\uC774\uAC00 \uC624\uB298\uC740 \uBC29 \uC785\uAD6C\uC5D0 \uC788\uB2E4.
    \uC798\uBABB \uBD24\uB098 \uC2F6\uC740 \uB2F9\uC2E0\uC744, \uB354 \uBD10\uB3C4
    \uB418\uB294\uB370 \uD558\uB294 \uB208\uC73C\uB85C \uBC14\uB77C\uBCF8\uB2E4."
  - "<b>Mamehinata</b>\n\uBAA8\uC784\uC774 \uC2DC\uC791\uD558\uAE30\uB3C4 \uC804\uC5D0
    \uBC14\uB2E5\uC740 \uB2EC\uB9AC\uAE30 \uCF54\uC2A4\uAC00 \uB410\uB2E4. \uBAA8\uB450\uAC00
    \uCC3E\uB294 \uB3D9\uC548 \uBC1C\uBC11\uC5D0\uC11C \uB2E4\uB978 \uBAA8\uC784\uC5D0
    \uCC38\uAC00 \uC911\uC774\uB2E4."
  - "<b>Usasaki</b>\n\uAD6C\uACBD\uB9CC \uD558\uB824\uB2E4\uAC00 \uAC70\uC6B8 \uC55E
    \uBA85\uB2F9\uC744 \uCC28\uC9C0\uD588\uB2E4. \uBB50 \uD558\uB0D0\uB294 \uC9C8\uBB38\uC5D0\uB294
    \uC544\uC8FC \uD06C\uAC8C \uCE68\uBB35\uC73C\uB85C \uB2F5\uD588\uB2E4."
  - "<b>Kuon</b>\n\uAC70\uC6B8 \uC55E\uC5D0\uC11C \uBA3C\uC800 \uC190\uC744 \uB0B4\uBC00
    \uC0AC\uB78C\uC744 \uAE30\uB2E4\uB9B0\uB2E4. \uC4F0\uB2E4\uB4EC\uAE30\uB294 \uD544\uC694
    \uC5C6\uACE0, \uC6B0\uC5F0\uD788 \uD3B8\uB9AC\uD55C \uACF3\uC5D0 \uC549\uC558\uC744
    \uBFD0\uC774\uB77C\uACE0 \uD55C\uB2E4."
  - "<b>Suzuhana</b>\n\uD76C\uADC0\uD55C \uC190\uB2D8\uC758 \uB4F1\uC7A5\uC740 \uD2B9\uBCC4\uD558\uB2E4.
    \uC544\uC9C1 \uBB38\uBC16\uC778\uB370 \uB300\uD654\uAC00 \uBA48\uCD94\uACE0 \uC790\uB9AC\uAC00
    \uBE44\uC5C8\uB2E4."
  - "<b>CarukiaRe</b>\n\uBAA8\uB450\uAC00 \uB3C4\uB3C4\uD55C \uACE0\uC591\uC774\uB77C\uACE0
    \uD558\uACE0, \uBCF8\uC778\uB3C4 \uB3D9\uC758\uD588\uB2E4. \uADF8\uB7EC\uACE0\uB294
    \uC4F0\uB2E4\uB4EC\uAE30 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uACF3\uC73C\uB85C \uC0B4\uC9DD
    \uC62E\uACBC\uB2E4. \uC5EC\uC804\uD788 \uB3C4\uB3C4\uD558\uAC8C."
  - "<b>Kipfel</b>\n\uBC14\uAC8C\uD2B8\uB294 \uC900\uBE44 \uC644\uB8CC. \uC810\uC2EC\uC73C\uB85C
    \uBA39\uC744\uC9C0 \uADFC\uC811 \uBB34\uAE30\uB85C \uC4F8\uC9C0\uB294 \uC544\uC9C1
    \uACE0\uBBFC \uC911\uC774\uB2E4. \uAC70\uC6B8 \uC55E\uC740 \uC624\uB298\uB3C4
    \uC870\uC6A9\uD558\uC9C0 \uC54A\uC744 \uB4EF\uD558\uB2E4."
  - "<b>Kokoa</b>\n\uC2E0\uBE44\uD55C \uCE5C\uAD6C\uAC00 \uC811\uC18D\uD588\uC9C0\uB9CC
    \uBC29\uC5D0\uB294 \uC880\uCC98\uB7FC \uC624\uC9C0 \uC54A\uB294\uB2E4. \uAD00\uC2EC
    \uC5C6\uB294 \uCC99\uD558\uBA74\uC11C \uC785\uAD6C\uB97C \uD314\uBC31 \uBC88
    \uD655\uC778\uD588\uB2E4."
  - "<b>Minahoshi</b>\n\uC785\uC7A5\uD558\uAE30\uB3C4 \uC804\uC5D0 \uC4F0\uB2E4\uB4EC\uAE30
    \uC904\uC774 \uBB38\uBC16\uAE4C\uC9C0 \uB298\uC5B4\uB0AC\uB2E4. \uC790\uB294
    \uCC99\uD558\uBA74 \uC790\uAE30\uC18C\uAC1C\uB97C \uAC74\uB108\uB6F8 \uC218 \uC788\uC744\uAE4C?"
  - "<b>Koyuki</b>\n\uC774 \uC637\uB9CC \uC218\uC815\uD558\uACE0 \uC794\uB2E4\uACE0
    \uB9D0\uD55C \uC9C0 \uC138 \uBC88\uC9F8 \uBC24. \uAC70\uC6B8 \uC55E\uC5D0\uC11C
    \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC2DC\uD5D8\uD560 \uC0C9\uC744 \uB610 \uBC1C\uACAC\uD588\uB2E4."
  - "<b>Photica</b>\n\uC624\uB298 \uBC24 \uC8FC\uC778\uACF5\uC774\uB77C\uACE0 \uC120\uC5B8\uD588\uB2E4.
    \uC544\uC9C1 \uC0AC\uC9C4\uC744 \uC548 \uCC0D\uB294\uB2E4\uACE0 \uD574\uB3C4,
    \uAC00\uC6B4\uB370 \uC790\uB9AC\uB97C \uBA3C\uC800 \uC7A1\uC73C\uBA74 \uB41C\uB2E4."
  - "<b>Maya</b>\n\uCE5C\uAD6C\uB294 \uC637\uB9CC \uAC08\uC544\uC785\uACE0 \uC628\uB2E4\uACE0
    \uD588\uB2E4. \uB9C8\uC57C\uB294 \uC0AC\uC9C4 \uC790\uB9AC\uB97C \uC7A1\uACE0
    \uC2ED \uBD84\uC9F8, \uC637\uC7A5\uC774 \uD1B5\uC9F8\uB85C \uBC14\uB00C\uB294
    \uAC8C \uC544\uB2D0\uAE4C \uC0DD\uAC01 \uC911\uC774\uB2E4."
  - "<b>MerryMare</b>\n\uACC4\uD68D\uC740 \uC644\uBCBD\uD558\uB2E4. \uB2F9\uC2E0
    \uC55E\uC744 \uC9C0\uB098\uACE0, \uBABB \uBCF8 \uCC99\uD558\uACE0, \uD55C \uBC88
    \uB354 \uC9C0\uB098\uAC04\uB2E4. \uC9C0\uAE08\uC740 \uB124 \uBC14\uD034\uC9F8\uB2E4."
  - "\uBB34\uC2A8 \uC77C\uC778\uC9C0 \uC54C\uAE30\uB3C4 \uC804\uC5D0 \uC2AC\uD508
    \uBC14\uC774\uC62C\uB9B0\uC774 \uC2DC\uC791\uB410\uB2E4. \uB2F9\uC2E0\uC774 \uD2F0\uCF13\uC744
    \uB4E4\uC790 \uBC8C\uC368 \uBABB \uACAC\uB514\uACA0\uB2E4\uB294 \uD45C\uC815\uC744
    \uC900\uBE44\uD588\uB2E4."
  - "\uAD6C\uCCB4\uB294 \uB3CC\uACE0, \uBC1C\uD1B1\uD30C\uB294 \uD68C\uC758 \uC911\uC774\uB2E4.
    \uACC4\uC0B0\uAE30\uB294 \uD6A8\uC728\uBD80\uD130 \uBCF4\uB77C\uC9C0\uB9CC \uB9C8\uC74C\uC18D
    \u201CClaw is law\u201D\uB294 \uC77C\uB2E8 \uBC1C\uD1B1\uC744 \uACE0\uB974\uB77C\uACE0
    \uD55C\uB2E4."
  - "\uD2F0\uCF13 \uB4B7\uBA74\uC5D0 \uB05D\uAE4C\uC9C0 \uB0A8\uC740 \uC0AC\uB78C\uC774
    \uC0C1\uAE08\uC744 \uBC1B\uB294\uB2E4. \uCE74\uBA54\uB77C\uB294 \uC5EC\uAE30\uB97C
    \uD5A5\uD55C\uB2E4. \uACBD\uAE30\uC7A5\uC744 \uC5EC\uB294 \uAC74 \uB2F9\uC2E0
    \uCC28\uB840\uB2E4."
  - "\uC606\uC5D0\uC11C\uB294 \uD589\uBCF5\uD55C \uC74C\uC545\uC774 \uB098\uC624\uC9C0\uB9CC
    \uBC14\uB098\uB098 \uACE0\uC591\uC774\uB294 \uC6B8 \uC900\uBE44\uAC00 \uB410\uB2E4.
    \uACB0\uACFC\uB97C \uBCF4\uAE30\uB3C4 \uC804\uC5D0 \uAF5D \uD2F0\uCF13 \uBAAB\uAE4C\uC9C0
    \uC6B8\uC5C8\uB2E4."
  - "\uAC70\uC6B8 \uAD6C\uC11D\uC740 \uC624\uB298 \uD734\uC5C5\uC774\uB77C\uBA70
    \uB7EC\uC2A4\uD06C\uAC00 \uAC00\uC7A5 \uBA3C\uC800 \uC549\uC558\uB2E4. \uC9C1\uC6D0\uC774\uB77C
    \uC549\uAE30 \uD3B8\uD55C\uC9C0 \uD655\uC778\uD574\uC57C \uD55C\uB2E4\uACE0 \uD55C\uB2E4."
  - "\uBC29\uC1A1\uC740 \uB2EC\uC544\uC62C\uB790\uC9C0\uB9CC \uC2A4\uD53C\uB4DC\uB294
    \uC544\uC9C1 \uACB0\uACFC\uB97C \uBAA8\uB978\uB2E4. \uAE30\uBED0\uD560 \uB54C
    \uB9C8\uC774\uD06C\uC5D0\uB294 \uBCC4\uB85C \uCE5C\uC808\uD558\uC9C0 \uC54A\uC73C\uB2C8
    \uB9C8\uC74C\uC758 \uC900\uBE44\uB97C \uD558\uC790."
  - "<b>Moe</b>\n\uAD6C\uACBD\uB9CC \uD558\uACE0 \uC0C8 \uC637\uC740 \uC548 \uC0B0\uB2E4.
    \uAC70\uC6B8 \uC18D \uBAA8\uC5D0\uB294 \uB044\uB355\uC600\uC9C0\uB9CC \uC7A5\uBC14\uAD6C\uB2C8
    \uC18D \uBAA8\uC5D0\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
  - "\uC785\uC744 \uC5F4\uACE0 \uB2EB\uC73C\uBA70 \uBC8C\uC368 \uC218\uC5C6\uC774
    \uD074\uB9AD\uD588\uB2E4. \uC138\uACC4 \uC21C\uC704\uB294 \uB178\uB825\uD560
    \uC218 \uC788\uC5B4\uB3C4 \uD2F0\uCF13\uC744 \uC5EC\uB294 \uAC74 \uB2F9\uC2E0
    \uCC28\uB840\uB2E4."
  - "<b>Airi</b>\n\uC624\uB298\uC740 \uC0AC\uC9C4\uC744 \uC548 \uCC0D\uACA0\uB2E4\uB294
    \uC544\uC774\uB9AC. \uCE5C\uAD6C\uAC00 \uCE74\uBA54\uB77C\uB97C \uB4E4\uC790
    \uBC8C\uC368 \uC870\uBA85\uC774 \uAC00\uC7A5 \uC88B\uC740 \uACF3\uC5D0 \uC11C
    \uC788\uC5C8\uB2E4."
  - "\uC544\uBB34\uB3C4 \uBABB \uBCF8 \uC637\uC73C\uB85C \uC785\uC7A5\uD588\uB294\uB370
    \uAC19\uC740 \uC637\uC744 \uC785\uC740 \uCE5C\uAD6C\uAC00 \uC14B\uC774\uB2E4.
    \uC774\uC81C \uAC00\uC6B4\uB370\uC5D0 \uB204\uAC00 \uC124\uC9C0\uAC00 \uBB38\uC81C\uB2E4."
  - "\uC870\uC6A9\uD788 \uC7A0\uAE50 \uC549\uC544 \uC788\uC744 \uC0DD\uAC01\uC774\uC5C8\uB2E4.
    \uC9C0\uB098\uAC00\uB358 \uCE5C\uAD6C\uAC00 \uC4F0\uB2E4\uB4EC\uC790 \uADF8 \uC7A0\uAE50\uC744
    \uC544\uCE68\uAE4C\uC9C0 \uC5F0\uC7A5\uD588\uB2E4."
  - "\uB2E8\uCCB4 \uC0AC\uC9C4\uC5D0 \uB9C8\uC9C0\uB9C9 \uD55C \uBA85\uC774 \uBD80\uC871\uD558\uB2E4.
    \uC1FC\uCF5C\uB77C\uB3C4 \uB4E4\uC5C8\uC9C0\uB9CC, \uAC00\uC7A5 \uB5A0\uB4E4\uC369\uD55C
    \uC21C\uAC04\uAE4C\uC9C0 \uB4F1\uC7A5\uC744 \uC544\uAEF4\uB480\uB2E4."
  - "\uC5B4\uB5A4 \uD2F0\uCF13\uC774 \uC798 \uB098\uC624\uB294\uC9C0 \uBAA8\uB450\uAC00
    \uD1A0\uB860 \uC911\uC774\uB2E4. \uADF8\uB294 \uC870\uC6A9\uD788 \uB044\uB355\uC77C
    \uBFD0\uC774\uB2E4. \uADF8 \uC5EC\uC720\uC5D0 \uD1A0\uB860\uC774 \uB9D0\uC744
    \uC783\uC5C8\uB2E4."
  - "Are you OK? \uC774\uBC88\uC5D0\uB294 \uC6C3\uC73C\uBA70 \uB2F5\uD560 \uC218
    \uC788\uB2E4. \uD76C\uADC0\uD55C \uC190\uB2D8\uC774 \uB4F1\uC7A5\uD574 \uC624\uB298
    \uBC1C\uD45C\uD68C\uB294 \uD589\uC6B4\uC744 \uB2F9\uC2E0\uC5D0\uAC8C \uC804\uB2EC\uD588\uB2E4."
  - "\uC624\uB298\uC740 \uAF2D \uC77C\uCC0D \uC794\uB2E4. \uB204\uAD70\uAC00 \uB178\uB798\uB97C
    \uD2C0\uC5B4\uC11C \uC81C\uBAA9\uB9CC \uD655\uC778\uD558\uAE30\uB85C \uD588\uB2E4.
    \uADF8\uB9AC\uACE0 \uB2E4\uC74C \uACE1 \uC81C\uBAA9\uB3C4."
  - "\uACB0\uACFC\uBCF4\uB2E4 \uBA3C\uC800 \uB208\uC379\uC774 \uC62C\uB77C\uAC14\uB2E4.
    \uB0AE\uC740 \uCFF5 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0 \uAC83 \uAC19\uC544\uC11C
    \uD2F0\uCF13\uB9C8\uC800 \uC218\uC0C1\uD574 \uBCF4\uC778\uB2E4."
  - "\uBC1C\uB85C \uAC77\uB294 \uACE0\uC591\uC774\uB3C4, \uB05D\uC5C6\uB294 \uC9C4\uD589
    \uB9C9\uB300\uCC98\uB7FC \uC6B0\uC8FC\uB97C \uAC00\uB85C\uC9C0\uB974\uB294 \uACE0\uC591\uC774\uB3C4
    \uC788\uB2E4. \uBB34\uC9C0\uAC1C\uAC00 \uC624\uAE30 \uC804\uBD80\uD130 \uBC18\uBCF5\uB418\uB294
    \uC6B8\uC74C\uC774 \uB4E4\uB9B4 \uB4EF\uD558\uB2E4."
  - "\uBC1C\uD45C\uD68C\uAC00 \uC2DC\uC791\uB418\uAE30 \uC804\uBD80\uD130 \uAC1D\uC11D\uC740
    \uADF8 \uC778\uC0AC\uC5D0 \uB2F5\uD560 \uC900\uBE44\uAC00 \uB410\uB2E4. \uD2F0\uCF13\uC744
    \uD655\uC778\uD558\uB294 \uB2F9\uC2E0\uC5D0\uAC8C \uADF8\uB294 \uC0C1\uD0DC\uAC00
    \uC5B4\uB5A4\uC9C0 \uBB3B\uACE0 \uC2F6\uB2E4."
  - "\uC548\uC804\uD558\uAC8C \uAC00\uC790\uB354\uB2C8 \uB610 \uCCB4\uB825\uC744
    \uACF5\uACA9\uB825\uC73C\uB85C \uBC14\uAFBC\uB2E4. \uBA3C\uC800 \uC8FD\uC774\uBA74
    \uB9C9\uC744 \uD544\uC694 \uC5C6\uB2E4\uBA70 \uCCAB \uCE35\uBD80\uD130 \uACC4\uC0B0
    \uC911\uC774\uB2E4."
  - "\uC0C1\uC810\uC5D0\uC11C \uBAA8\uB450\uAC00 \uAC00\uACA9\uC744 \uBCFC \uB54C
    \uADF8\uB294 \uC2E0\uBD84\uC5D0 \uB9DE\uB294 \uC5F0\uCD9C\uC744 \uCC3E\uB294\uB2E4.
    \uC655\uC88C\uB294 \uB098\uC911\uC5D0 \uC640\uB3C4 \uB418\uC9C0\uB9CC \uB4F1\uC7A5\uD558\uB294
    \uC704\uC5C4\uC740 \uC9C0\uAE08 \uD544\uC694\uD558\uB2E4."
  - "\uD3C9\uC628\uC744 \uC720\uC9C0\uD558\uC790\uB354\uB2C8 \uB2E4\uC74C\uC5D0 \uC804\uBD80
    \uAC00\uC838\uAC08 \uC218 \uC5C6\uC744\uAE4C \uACE0\uBBFC\uD55C\uB2E4. \uACC4\uC0B0\uBD80\uD130
    \uD558\uB77C\uB294 \uCE5C\uAD6C\uC5D0\uAC8C \uB044\uB355\uC5EC\uB3C4 \uC190\uC740
    \uC0C1\uAE08 \uCC3D\uC744 \uB5A0\uB098\uC9C0 \uC54A\uB294\uB2E4."
  - "\uD30C\uB780 \uC2DC\uC791\uAD8C\uC740 100 \uD655\uC815(\uC548 \uAE01\uC5B4\uB3C4
    \uAD50\uD658 \uAC00\uB2A5) \u2192 \uAD6C\uB9E4 \u2192 0.6\uCD08 \uAE38\uAC8C
    \u2192 \uB2F9\uCCA8\uAD8C \uD68C\uC218"
  - "\uC5B4\uB514\uC11C \uBCF8 \uAC83 \uAC19\uB2E4\uACE0 \uCE5C\uAD6C\uAC00 \uB9D0\uD55C\uB2E4.
    \uC5B4\uC81C\uC600\uC744\uAE4C? \uC5B4\uC81C\uB3C4 \uADF8\uC81C\uB3C4 \uC9C0\uB09C\uC8FC\uB3C4
    \uAC19\uC740 \uAC70\uC6B8 \uC55E\uC774\uC5C8\uB2E4."
  - "\uC791\uC5C5\uB300\uB294 \uC900\uBE44\uB410\uC9C0\uB9CC \uC7AC\uB8CC\uAC00 \uBD80\uC871\uD558\uB2E4.
    \uB2E4\uC774\uC544\uBAAC\uB4DC\uB97C \uCE90\uB294 \uB300\uC2E0 \uC774 \uD2F0\uCF13\uC73C\uB85C
    \uD589\uC6B4\uC744 \uC81C\uC791\uD560 \uC218 \uC5C6\uC744\uAE4C \uACE0\uBBFC
    \uC911\uC774\uB2E4."
  - "\uC791\uC740 \uB3D9\uBB3C\uB4E4\uC774 \uC904 \uC11C\uB294 \uB3D9\uC548 \uD070
    \uAC1C\uB294 \uBAA8\uB450\uB97C \uB300\uC2E0\uD574 \uBC1C\uC5B8 \uC911\uC774\uB2E4.
    \uC774 \uD2F0\uCF13 \uBA3C\uC800 \uBCF4\uC5EC\uB2EC\uB77C\uB294 \uC18C\uB9AC\uAC00
    \uD654\uBA74 \uB108\uBA38\uB85C \uB4E4\uB9B4 \uAC83 \uAC19\uB2E4."
  - "\uC870\uAE08 \uB4A4 \uC6C0\uC9C1\uC774\uACA0\uB2E4\uB294 \uADF8\uB140 \uC606\uC5D0\uC11C
    \uB3D9\uB8CC\uB294 \uBC8C\uC368 \uC55E\uC73C\uB85C \uAC14\uB2E4. \uAD50\uB300
    \uADFC\uBB34 \uAC19\uC9C0\uB9CC \uB458 \uB2E4 \uC274 \uC0DD\uAC01\uC740 \uC5C6\uB2E4."
  - "\uAC70\uC6B8\uB9CC \uC7A0\uAE50 \uBCF4\uB824\uB2E4\uAC00 \uB2E8\uCCB4 \uC0AC\uC9C4\uC5D0
    \uB04C\uB824\uAC14\uB2E4. \uBA38\uB9BF\uC18D\uC5D0\uC11C\uB294 \uC774 \uC0AC\uC9C4\uB9CC
    \uCC0D\uACE0 \uC885\uB8CC\uD55C\uB2E4\uACE0 \uC5F0\uC2B5 \uC911\uC774\uB2E4."
  - "\uB2F9\uC2E0\uC758 \uACF5\uAC1C\uB294 \uBE68\uB790\uB2E4. \uC2A4\uC2B9\uC740
    \uC124\uBA85\uC744 \uC904\uC774\uACE0 \uD589\uC6B4\uACFC \uC775\uC219\uD55C \uB2F9\uBD80\uB97C
    \uB0A8\uACBC\uB2E4. \uBD80\uB514 \uC54C\uC544\uC11C \uC798\uD558\uAE38."
  - "\uC5EC\uB294 \uC21C\uAC04 \uD070 \uBC18\uC751\uC774 \uCD95\uD558\uB85C \uBC14\uB00C\uC5C8\uB2E4.
    \uC18C\uB9AC \uD06C\uAE30\uB294 \uADF8\uB300\uB85C\uC9C0\uB9CC \uC774\uBC88\uC5D0\uB294
    \uC804\uBD80 \uB2F9\uC2E0\uC744 \uC751\uC6D0\uD55C\uB2E4."
  - "\uB2E4\uC2DC\uB294 \uBF51\uC9C0 \uC54A\uACA0\uB2E4\uACE0 \uB2F9\uB2F9\uD788
    \uC120\uC5B8\uD588\uB2E4. \uADF8\uB7F0\uB370 \uC0C1\uC790 \uC606\uC744 \uC9C0\uB098\uBA70
    \uC0C1\uAE08 \uCC3D\uC744 \uC2AC\uCA4D \uBCF4\uACE0 \uB9D0\uC558\uB2E4."
  - "\uACE0\uC591\uC774\uB3C4 \uBE75 \uACF5\uACA9\uB3C4 \uBC1B\uC544\uB0C8\uB2E4.
    \uC624\uB298\uC758 \uC804\uB9AC\uD488\uC740 \uBE75 \uBD80\uC2A4\uB7EC\uAE30 \uB300\uC2E0
    \uAC04\uC9C1\uD560 \uB9CC\uD55C \uD2F0\uCF13 \uD55C \uC7A5\uC774\uB2E4."
  - "\uB9C8\uC9C0\uB9C9 \uD55C \uBA85\uC774 \uB2F9\uC2E0\uC5D0\uAC8C \uC654\uB2E4.
    \uB2E8\uCCB4 \uC0AC\uC9C4\uC774 \uC644\uC131\uB418\uAE30 \uC804\uC5D0 \uCEEC\uB809\uC158\uC5D0
    \uB9C8\uC9C0\uB9C9 \uC8FC\uC778\uACF5\uC774 \uB3C4\uCC29\uD588\uB2E4."
  - "\uB2F9\uC2E0\uC774 \uD2F0\uCF13\uC744 \uC5F4\uC5B4 \uCC4C\uB9B0\uC9C0\uAC00
    \uB05D\uB0AC\uB2E4. \uC601\uC0C1 \uC81C\uBAA9\uC758 \uACFC\uC7A5\uB41C \uC22B\uC790
    \uB300\uC2E0 \uC774\uBC88 \uD589\uC6B4\uC758 \uC0C1\uAE08\uC744 \uC5BB\uC5C8\uB2E4."
  - "\uC774 \uB144 \uBC18\uC758 \uC5F0\uC2B5, \uB4F1\uC7A5\uAE4C\uC9C0 \uD55C \uBC88\uB9CC
    \uB354 \uB2F9\uAE30\uBA74 \uB41C\uB2E4. \uB178\uB798\uB3C4 \uCDA4\uB3C4 \uB18D\uAD6C\uB3C4
    \uC900\uBE44\uB410\uB2E4. \uBB34\uB300 \uB4A4\uB294 \uC2DC\uC791 \uC2E0\uD638\uB97C
    \uAE30\uB2E4\uB9B0\uB2E4."
  - "\uC774 \uD2F0\uCF13\uC5D0\uB294 \uCC98\uCE58 \uACC4\uC0B0\uC774 \uD544\uC694
    \uC5C6\uB2E4. \uACB0\uACFC\uB294 \uB2F9\uC2E0\uC5D0\uAC8C, \uB0A8\uC740 \uD589\uC6B4\uC740
    \uB2E4\uC74C \uBAA8\uB2E5\uBD88\uACFC \uCD9C\uBC1C\uC744 \uC704\uD574 \uB0A8\uACBC\uB2E4."
  - "PC: \u2190 / \u2192 \uB85C \uC120\uD0DD, \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744
    \uAE38\uAC8C \uB20C\uB7EC \uC5F4\uAE30.\nVR: \uC88C\uC6B0 \uADF8\uB9BD\uC73C\uB85C
    \uC120\uD0DD, \uD2B8\uB9AC\uAC70\uB97C \uAE38\uAC8C \uB20C\uB7EC \uC5F4\uAE30."
  - "\uAE30\uB2E4\uB9BC\uC774 \uB05D\uB098\uACE0 \uB2F9\uC2E0\uC774 \uC654\uB2E4.
    \uC0AC\uC9C4 \uAC00\uC6B4\uB370 \uC790\uB9AC\uB294 \uBE44\uC6CC\uB480\uB2E4.
    \uCEEC\uB809\uC158\uB3C4 \uD568\uAED8 \uCC0D\uB294 \uC0AC\uC9C4\uC774 \uB420
    \uC218 \uC788\uB2E4."
  - "\uAC80\uC0AC \uACB0\uACFC \uD569\uACA9, \uCEEC\uB809\uC158 \uC790\uB9AC\uB3C4
    \uD3B8\uD558\uB2E4. \uC601\uC5C5 \uC7AC\uAC1C\uB97C \uD5C8\uB77D\uD558\uACE0
    \uBCF8\uC778\uC774 \uBA3C\uC800 \uC774\uC6A9\uD574 \uBCF4\uAE30\uB85C \uD588\uB2E4."
  - "\uACB0\uACFC\uAC00 \uB728\uC790 \uBC8C\uC368 \uB6F0\uACE0 \uC788\uB2E4. \uB2F9\uC2E0\uC774
    \uC0C1\uAE08\uC744 \uD655\uC778\uD558\uB294 \uC0AC\uC774, \uADF8\uB294 \uB9C8\uC9C0\uB9C9
    \uC21C\uAC04\uC758 \uACB0\uC2B9 \uACE8\uCC98\uB7FC \uCD95\uD558\uD588\uB2E4."
  - "\uB73B\uBC16\uC758 \uC88B\uC740 \uC18C\uC2DD\uC774\uB2E4. \uD584\uC2A4\uD130\uB294
    \uBA48\uCDC4\uACE0, \uC0C1\uC0C1 \uC18D \uBC14\uC774\uC62C\uB9B0\uC774 \uB05D\uB098\uAE30\uB3C4
    \uC804\uC5D0 \uB2F9\uC2E0\uC774 \uD589\uC6B4\uC744 \uCC59\uACBC\uB2E4."
  - "\uC774\uC81C \uC5F0\uC2B5\uC774 \uB05D\uB098\uAE38 \uAE30\uB2E4\uB9B4 \uD544\uC694
    \uC5C6\uB2E4. \uB2F9\uC2E0\uC774 \uAD00\uAC1D\uC774 \uB418\uACE0, \uD589\uC6B4\uC740
    \uBA4B\uC9C0\uAC8C \uB3CC\uC544 \uCEEC\uB809\uC158\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4."
  - "\uB2E8\uAC80\uC77C\uAE4C \uB3C5\uC77C\uAE4C, \uD55C \uC7A5 \uB354 \uBF51\uC744\uAE4C.
    \uC870\uC6A9\uD55C \uD134\uCC98\uB7FC \uBCF4\uC5EC\uB3C4 \uB4A4\uC758 \uC190\uD328\uB294
    \uC774\uBBF8 \uC791\uC740 \uAD70\uB300\uB2E4."
  - "\uAD6C\uACBD\uD558\uB358 \uC790\uB9AC\uAC00 \uB2F9\uC2E0\uC758 \uCEEC\uB809\uC158
    \uC790\uB9AC\uAC00 \uB410\uB2E4. \uC218\uC0C1 \uC18C\uAC10 \uB300\uC2E0 \uB2F9\uC2E0\uC744
    \uC704\uD55C \uC790\uB9AC\uB97C \uB0A8\uACA8\uB480\uB2E4."
  - "\uB2F9\uC2E0\uC774 \u201C\uC870\uAE08\uB9CC \uB354\u201D\uC5D0\uC11C \uAEBC\uB0B4\uC92C\uB2E4.
    \uC624\uB298\uC740 \uC815\uB9D0 \uB05D\uB0BC \uC218 \uC788\uB2E4. \uC774 \uD2F0\uCF13
    \uC0C9\uC740 \uB354 \uACE0\uCE60 \uD544\uC694\uAC00 \uC5C6\uB2E4."
  - "\uC774\uBC88\uC5D4 \uC811\uC18D \uC54C\uB9BC\uB9CC\uC774 \uC544\uB2C8\uB2E4.
    \uC815\uB9D0\uB85C \uC654\uB2E4. \uC774\uC81C \uC785\uAD6C \uB300\uC2E0 \uCEEC\uB809\uC158\uC5D0
    \uC549\uC740 \uC190\uB2D8\uC744 \uBCF4\uBA74 \uB41C\uB2E4."
  - "\uCC29\uAC01\uC774 \uC544\uB2C8\uB2E4. \uC2E0\uBE44\uD55C \uACE0\uC591\uC774\uAC00
    \uB2F9\uC2E0\uC744 \uACE8\uB790\uB2E4. \uC0AC\uC9C4 \uC18D \uC791\uC740 \uD55C
    \uCE78\uC774 \uD2B9\uBCC4\uD55C \uCEEC\uB809\uC158 \uD55C \uCE78\uC774 \uB410\uB2E4."
  - "\uB178\uB798\uAC00 \uB05D\uB098\uAE30 \uC804\uC5D0 \uB2F9\uC2E0\uC774 \uBF51\uC558\uB2E4.
    \uC624\uB298 \uBC24 \uCD94\uAC00\uB41C \uACE1\uC758 \uC81C\uBAA9\uC740 \u201C\uD589\uC6B4\uC740
    \uC815\uB9D0 \uCC3E\uC544\uC628\uB2E4\u201D\uB2E4."
  - "\uBB34\uC9C0\uAC1C\uAC00 \uB4DC\uB514\uC5B4 \uD2F0\uCF13 \uC0C1\uC790\uC5D0
    \uB3C4\uCC29\uD588\uB2E4. \uC6B8\uC74C\uC740 \uBB34\uD55C \uBC18\uBCF5\uC774\uC5B4\uB3C4
    \uC774 \uD76C\uADC0\uD55C \uD55C \uC7A5\uC740 \uB354 \uC774\uC0C1 \uBA3C \uC810\uC774
    \uC544\uB2C8\uB2E4."
  - "\uACB0\uACFC\uAC00 \uB098\uC624\uC790 \uC120\uC5B8\uC740 \uC790\uB3D9 \uCDE8\uC18C\uB410\uB2E4.
    \uB2F9\uC2E0\uC758 \uB2F9\uCCA8 \uD2F0\uCF13\uC744 \uBCF4\uACE0\uB294 \uC5ED\uC2DC
    \uC88B\uB2E4\uBA70 \uAC10\uD0C4\uD588\uB2E4."
  - "\uC774\uBC88 \uB4DC\uB85C\uC6B0\uB294 \uBCF8\uC778\uC774\uC5C8\uB2E4. \uAD6C\uCCB4\uC640
    \uBC1C\uD1B1\uC740 \uC7A0\uC2DC \uD734\uC804\uD558\uACE0, \uD589\uC6B4\uC744
    \uCEEC\uB809\uC158\uC5D0 \uB0A8\uAE30\uAE30\uB85C \uB9CC\uC7A5\uC77C\uCE58\uD588\uB2E4."
  - "\uB2F9\uC2E0\uC774 \uCC3E\uC544\uB0C8\uB2E4. \uC4F0\uB2E4\uB4EC\uAE30 \uC904\uC5D0
    \uD55C \uBA85\uC774 \uB354 \uB298\uC5B4\uC11C, \uC774\uBC88\uC5D0\uB294 \uAE68\uC5B4\uC11C
    \uAE30\uB2E4\uB9AC\uAE30\uB85C \uD588\uB2E4."
  - "\uB3C4\uB3C4\uD568\uC740 \uADF8\uB300\uB85C, \uC774\uBC88\uC5D4 \uB2F9\uC2E0
    \uC606\uC774\uB2E4. \uB2F9\uCCA8 \uD2F0\uCF13\uC744 \uBC00\uC5B4\uC8FC\uACE0\uB294
    \uBCC4\uC77C \uC544\uB2C8\uB77C\uB294 \uCC99\uD55C\uB2E4."
  - "\uBB38\uC774 \uC5F4\uB9AC\uC790 \uC190\uB2D8\uC740 \uB2F9\uC2E0\uC5D0\uAC8C
    \uC654\uB2E4. \uBAA8\uB450\uAC00 \uB204\uAD6C\uB0D0\uACE0 \uBB3B\uB294 \uB3D9\uC548,
    \uB2F9\uC2E0\uC740 \uB9CC\uB0A8\uC758 \uAE30\uB150\uC744 \uC190\uC5D0 \uB123\uC5C8\uB2E4."
  - "\uC81C\uC791 \uC131\uACF5. \uCE58\uD0A8 \uC870\uD0A4\uAC00 \uD280\uC5B4\uB098\uC624\uC9C4
    \uC54A\uC558\uC9C0\uB9CC \uC2A4\uD2F0\uBE0C\uAC00 \uC9C4\uC9C0\uD558\uAC8C \uB044\uB355\uC600\uB2E4."
  - "\uC774\uBC88 \uD2F0\uCF13\uC740 \uC548 \uC6B8\uC5B4\uB3C4 \uB41C\uB2E4. \uB2F9\uC2E0\uC758
    \uD589\uC6B4\uC744 \uBCF4\uBA70 \uC0C1\uC0C1 \uC18D \uBC30\uACBD \uC74C\uC545\uC744
    \uD589\uBCF5 \uBC84\uC804\uC73C\uB85C \uBC14\uAFC0\uAE4C \uC0DD\uAC01\uD55C\uB2E4."
  - "\uD55C\uB208\uC5D0 \uB529\uC804, \uAC10\uC815 \uACB0\uACFC\uB294 \u201C\uC544\uC9C1
    \uC548 \uC5F4\uC5C8\uB2E4\u201D. \uAC10\uC815\uC11D\uC740 \uB9CC\uC11D\uC774\uC9C0\uB9CC
    \uD2F0\uCF13\uC740 \uB2F5\uC744 \uBBF8\uB9AC \uBCF4\uC5EC\uC8FC\uC9C0 \uC54A\uB294\uB2E4."
  - "\uBC88\uAC1C \uC624\uC5F0\uD0C0\uB294 \uC900\uBE44\uB410\uC9C0\uB9CC \uC0C1\uAE08
    \uCC3D\uC740 \uC544\uC9C1 \uB2EB\uD614\uB2E4. \uAC00\uBCCD\uAC8C \uACA8\uB8F0
    \uC0DD\uAC01\uC774\uC5C8\uB294\uB370 \uD589\uC6B4\uC740 \uB450 \uC218 \uB354
    \uACA8\uB8E8\uACE0 \uC2F6\uC740 \uBAA8\uC591\uC774\uB2E4."
  - "\uC774\uBC88 \uD134\uC758 \uC88B\uC740 \uC18C\uC2DD\uC774 \uB3C4\uCC29\uD588\uB2E4.
    \uADF8\uB140\uC640 \uB3D9\uB8CC\uAC00 \uD638\uD761\uC744 \uB9DE\uCDB0 \uAE30\uB150\uD560
    \uD55C \uC7A5\uC744 \uB2F9\uC2E0\uC5D0\uAC8C \uC804\uD588\uB2E4."
  - "\uD3C9\uC628\uC774 \uB180\uB77C\uC6C0\uC73C\uB85C \uBC14\uB00C\uC5C8\uB2E4.
    \uACC4\uC0B0 \uC2E4\uC218\uB3C4 \uC7AC\uC2DC\uC791\uB3C4 \uC5C6\uC774 \uD76C\uADC0\uD55C
    \uC190\uB2D8\uC774 \uB2F9\uC2E0\uC758 \uCEEC\uB809\uC158\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
  - "\uB0B4 \uD2F0\uCF13 \xB7 \uBBF8\uAC1C\uBD09 {0}\uBB36\uC74C\n\uBBF8\uD655\uC778
    {1}\uC7A5 \xB7 \uB2F9\uCCA8 {2}\uC7A5\n\uBBF8\uC218\uB839 \uB2F9\uCCA8\uAE08
    {3}"
  - "\uB4DC\uB514\uC5B4 \uC544\uB798\uB97C \uB0B4\uB824\uB2E4\uBD24\uB2E4. \uD2F0\uCF13
    \uB4B7\uBA74\uBD80\uD130 \uCEEC\uB809\uC158\uAE4C\uC9C0, \uC774\uBC88 \uD0D0\uD5D8\uB3C4
    \uB300\uC131\uACF5\uC774\uB2E4."
  - "\uB9C8\uC9C0\uB9C9 \uD55C \uC7A5\uC774\uB77C\uBA70 \uD55C \uC7A5\uC744 \uB354
    \uB0A8\uACBC\uB2E4. \uC0AC\uC9C4\uC740 \uB118\uAE38 \uC218 \uC788\uC5B4\uB3C4
    \uC774\uBC88 \uD589\uC6B4\uC740 \uACC4\uC18D \uB2F4\uACA8 \uC788\uB2E4."
  - "\uB2F9\uC2E0\uC774 \uD2F0\uCF13\uC744 \uC5F4\uBA74\uC11C \uC2A4\uCCD0 \uC9C0\uB098\uAC00\uAE30
    \uC791\uC804\uC774 \uB05D\uB0AC\uB2E4. \uD589\uC6B4\uC744 \uC804\uD55C \uAC83\uB3C4
    \uADF8\uB0E5 \uC9C0\uB098\uAC00\uB294 \uAE38\uC774\uC5C8\uB2E4\uACE0 \uD55C\uB2E4."
  - "\uC775\uC219\uD55C \uBAA8\uC2B5\uC774 \uB2F9\uC2E0\uC758 \uCEEC\uB809\uC158\uC5D0
    \uB4E4\uC5B4\uC654\uB2E4. \uC6B0\uC5F0\uD55C \uC7AC\uD68C \uB300\uC2E0, \uC774\uBC88\uC5D4
    \uD589\uC6B4\uC774 \uB2F9\uC2E0\uC744 \uC704\uD574 \uBA48\uCDC4\uB2E4."
  - "\uACB0\uACFC\uB97C \uBCF4\uC5EC\uC8FC\uC790 \uB208\uC379\uB3C4 \uD589\uC6B4\uC744
    \uC778\uC815\uD588\uB2E4. \uC774\uBC88 \uCFF5 \uC18C\uB9AC\uB294 \uB2F9\uC2E0\uC758
    \uB4F1\uC7A5 \uD6A8\uACFC\uC74C\uC774\uB2E4."
  - "\uD31D! \uADF8 \uD55C \uBC88\uC774 \uB4DC\uB514\uC5B4 \uD589\uC6B4\uC73C\uB85C
    \uC774\uC5B4\uC84C\uB2E4. \uD69F\uC218\uB294 \uACC4\uC18D \uC62C\uB77C\uAC00\uACE0,
    \uC774\uBC88 \uD074\uB9AD\uC740 \uB2F9\uC2E0\uC758 \uCEEC\uB809\uC158\uC5D0 \uB0A8\uC558\uB2E4."
  - "\uC774\uBC88\uC5D4 \uB2F9\uC2E0\uC774 \uBCF8\uC778\uC744 \uBF51\uC558\uB2E4.
    \uB9C8\uC9C0\uB9C9 \uC190\uD328\uB97C \uC5F4\uC790 \uD589\uC6B4\uC740 \uBC84\uB824\uC9C0\uC9C0
    \uC54A\uACE0 \uCEEC\uB809\uC158\uC5D0 \uB0A8\uC558\uB2E4."
  - "\uD589\uC6B4\uC774 \uACC1\uC5D0 \uB0B4\uB824\uC549\uC558\uB2E4. \uAE30\uB2E4\uB838\uB2E4\uACE0
    \uC778\uC815\uD558\uC9C4 \uC54A\uC9C0\uB9CC, \uB2F9\uC2E0\uC758 \uCEEC\uB809\uC158
    \uC790\uB9AC\uB294 \uBE44\uC6CC\uB480\uB2E4."
  - "\uAE30\uB2E4\uB9AC\uB358 \uC2DC\uAC04\uC774 \uAE30\uB150\uC774 \uB410\uB2E4.
    \uB3CC\uC544\uAC00\uB77C\uACE0 \uD558\uC9C0 \uC54A\uB294\uB2E4. \uC774 \uCEEC\uB809\uC158
    \uC790\uB9AC\uC5D0\uC11C\uB3C4 \uC870\uAE08 \uB354 \uC26C\uC5B4\uAC00\uC790."
  - "\uB2F9\uC2E0\uC774 \uD2F0\uCF13\uC744 \uC5F4\uC5B4 \uB9C8\uC9C0\uB9C9 \uD658\uD638\uB97C
    \uBCF4\uD0F0\uB2E4. \uC655\uC88C\uB294 \uADF8\uC758 \uAC83, \uC774\uBC88 \uB2F9\uCCA8\uC758
    \uAE30\uB150\uC740 \uB2F9\uC2E0\uC758 \uAC83\uC774\uB2E4."
  - "\uD30C\uB780 \uC2DC\uC791\uAD8C\uC744 \uC5F4\uACE0 \uAD50\uD658\uD574 100$\uB97C
    \uBC1B\uC73C\uC138\uC694.\n\uC774\uD6C4 \uCEE8\uBCA0\uC774\uC5B4\uC5D0\uC11C
    \uD2F0\uCF13\uC774\uB098 \uD329\uC744 \uC9D1\uC73C\uBA74 \uACB0\uC81C\uB429\uB2C8\uB2E4."
  - "\uC774\uBC88\uC5D4 \uC637\uAC12\uC744 \uACB0\uC81C\uD560 \uD544\uC694\uAC00
    \uC5C6\uB2E4. \uB2F9\uC2E0\uC774 \uBF51\uC544\uB0B8 \uBAA8\uC5D0\uB294 \uD589\uC6B4\uACFC
    \uD568\uAED8 \uCEEC\uB809\uC158\uC73C\uB85C \uAC08\uC544\uC785\uC5C8\uB2E4."
  - "\uC8FC\uC778\uACF5\uC774 \uD2F0\uCF13 \uD55C \uC7A5\uC5D0 \uB2F4\uACBC\uB2E4.
    \uB2F9\uC2E0\uC5D0\uAC8C \uB044\uB355\uC774\uBA70 \uC774\uBC88 \uD589\uC6B4\uC744
    \uAC1C\uC778 \uC21C\uD68C\uC804\uC5D0 \uCD94\uAC00\uD558\uB3C4\uB85D \uD5C8\uB77D\uD588\uB2E4."
  - "\uC0AC\uC9C4\uC744 \uCC0D\uAE30\uB3C4 \uC804\uC5D0 \uB2F9\uC2E0\uC774 \uBF51\uC558\uB2E4.
    \uC885\uB8CC\uB294 \uC870\uAE08 \uBBF8\uB8E8\uACE0, \uBA3C\uC800 \uC774 \uB9CC\uB0A8\uC744
    \uCD95\uD558\uD558\uC790."
  - "\uB2F9\uC2E0\uB9CC\uC758 \uD55C \uBA85\uC744 \uBF51\uC558\uB2E4. \uC637\uC740
    \uACB9\uCE60 \uC218 \uC788\uC5B4\uB3C4 \uC774 \uD2F0\uCF13\uC758 \uD589\uC6B4\uC740
    \uB2F9\uC2E0\uC744 \uACE8\uB790\uB2E4."
  - "\uADF8 \uC5EC\uC720\uB97C \uBF51\uC558\uB2E4. \uADF8\uB3C4 \uB044\uB355\uC774\uACE0
    \uB2F9\uC2E0\uB3C4 \uB044\uB355\uC778\uB2E4. \uC774\uBC88 \uD589\uC6B4\uC5D0\uB294
    \uCD94\uAC00 \uD1A0\uB860\uC774 \uD544\uC694 \uC5C6\uB2E4."
  - "\uD55C\uB208\uC5D0 \uB529\uC804, \uAC10\uC815 \uACB0\uACFC\uB294 \u201C\uC9C4\uC9DC
    \uB2F9\uCCA8\u201D. \uD655\uB300\uD574\uC11C \uCC3E\uC744 \uD544\uC694 \uC5C6\uC774
    \uACB0\uACFC\uAC00 \uB2F9\uC2E0 \uC190\uC5D0 \uC788\uB2E4."
  - "\uBCC4\uB3C4 QR \uCF54\uB4DC\uB85C \uACC4\uC815\uC744 \uC5F0\uB3D9\uD558\uC138\uC694.\n\uBA64\uBC84\uC2ED
    \uAC00\uC785 \uD6C4 \uC870\uC791 \uD328\uB110\uC5D0\uC11C \uAF5D \uD2F0\uCF13
    \uC989\uC2DC \uC18C\uAC01\uC744 \uCF1C\uC138\uC694."
  - "\uB2F9\uCCA8 \uD2F0\uCF13\uC740 \uAD50\uD658\uD558\uAC70\uB098 \uD2F0\uCF13
    \uC0C1\uC790\uC5D0 \uBCF4\uAD00\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB2F9\uCCA8\uAE08\uC740
    \uAD50\uD658 \uD6C4 \uC9C0\uAE09\uB418\uACE0, \uAF5D \uD2F0\uCF13\uC740 \uC790\uB3D9
    \uC18C\uAC01\uB429\uB2C8\uB2E4."
  - "\uC2DC\uC791\uAD8C\uC740 100 \uD655\uC815\uC785\uB2C8\uB2E4. \uC548 \uAE01\uC5B4\uB3C4
    \uAD50\uD658\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."

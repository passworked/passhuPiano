  - "\u8FD8\u5728\u51B7\u5374\u54E6"
  ja:
  - "25% \u3068\u9AD8\u984D\u8CFC\u5165\u4E88\u7B97\u3092\u6709\u52B9\u306B\u3059\u308B\u3068\u3001\u653E\u7F6E\u4E2D\u306F\u78BA\u8A8D\u306A\u3057\u3067\u3001\u5229\u7528\u53EF\u80FD\u6B8B\u9AD8\u306E
    25% \u307E\u3067\u306E\u30C1\u30B1\u30C3\u30C8\u3092\u6BCE\u56DE\u8CFC\u5165\u3057\u3001\u73FE\u5728\u306E\u8A2D\u5B9A\u3067\u958B\u5C01\u3092\u7D9A\u3051\u307E\u3059\u3002\u4E88\u7B97\u306E\u4F4E\u3044\u6BB5\u968E\u306B\u5207\u308A\u66FF\u3048\u308B\u3053\u3068\u3082\u3001\u9AD8\u984D\u8CFC\u5165\u4E88\u7B97\u3092\u4F7F\u3046\u3053\u3068\u3082\u3067\u304D\u307E\u3059\u3002"
  - "<size=65%><color=#B8C7B8>\u958B\u5C01\u6E08\u307F\u5408\u8A08</color></size> 
    <b>{0}</b> <size=60%>\u679A</size>"
  - "\u300C\u653E\u7F6E\u300D\u8CFC\u5165\u5F8C\u3001VR\u306F\u30EC\u30D0\u30FC\u3092\u4E0B\u3052\u3066\u958B\u59CB\u3001\u4E0A\u3052\u3066\u505C\u6B62\u3002\nPC\u306F\u30AF\u30EA\u30C3\u30AF\u3067\u5207\u66FF\u3002\u624B\u3067\u5238\u3092\u53D6\u308B\u3068\u653E\u7F6E\u306F\u505C\u6B62\u3002\n\u8CFC\u5165\u3057\u305F\u5238\u309210\u679A\u958B\u5C01\u5F8C\u3001\u300C\u4E00\u62EC\u958B\u5C01\u300D\u3082\u4F7F\u3048\u307E\u3059\u3002"
  - "<b>Ricorine</b>\n\u53CB\u9054\u306E\u5199\u771F\u3067\u3057\u304B\u898B\u306A\u3044\u8B0E\u306E\u732B\u304C\u3001\u4ECA\u65E5\u306F\u90E8\u5C4B\u306E\u5165\u53E3\u306B\u3002\u898B\u9593\u9055\u3044\u304B\u3068\u601D\u3046\u3042\u306A\u305F\u3092\u3001\u3082\u3063\u3068\u898B\u3066\u3082\u3044\u3044\u306E\u306B\u3068\u898B\u3066\u3044\u308B\u3002"
  - "<b>Mamehinata</b>\n\u96C6\u4F1A\u524D\u304B\u3089\u5E8A\u306F\u8C46\u67F4\u306E\u8D70\u8DEF\u3002\u307F\u3093\u306A\u304C\u63A2\u3057\u3066\u3044\u308B\u9593\u3001\u8DB3\u5143\u3067\u5225\u306E\u96C6\u4F1A\u3092\u958B\u3044\u3066\u3044\u305F\u3002"
  - "<b>Usasaki</b>\n\u805E\u304F\u3060\u3051\u306E\u3064\u3082\u308A\u304C\u3001\u93E1\u306E\u524D\u306E\u7279\u7B49\u5E2D\u3092\u78BA\u4FDD\u6E08\u307F\u3002\u4F55\u3092\u3057\u3066\u3044\u308B\u304B\u805E\u304B\u308C\u3066\u3001\u7121\u8A00\u3067\u5927\u304D\u304F\u7B54\u3048\u305F\u3002"
  - "<b>Kuon</b>\n\u93E1\u306E\u524D\u3067\u3001\u5148\u306B\u624B\u3092\u4F38\u3070\u3057\u3066\u304F\u308C\u308B\u4EBA\u3092\u5F85\u3063\u3066\u3044\u308B\u3002\u306A\u3067\u306A\u3067\u306F\u4E0D\u8981\u3001\u305F\u307E\u305F\u307E\u4FBF\u5229\u306A\u5834\u6240\u306B\u5EA7\u3063\u305F\u3060\u3051\u3089\u3057\u3044\u3002"
  - "<b>Suzuhana</b>\n\u73CD\u3057\u3044\u6765\u5BA2\u306E\u5165\u5834\u306F\u7279\u5225\u3002\u307E\u3060\u30C9\u30A2\u306E\u5916\u306A\u306E\u306B\u3001\u4F1A\u8A71\u304C\u6B62\u307E\u3063\u3066\u5E2D\u304C\u7A7A\u3044\u305F\u3002"
  - "<b>CarukiaRe</b>\n\u30AF\u30FC\u30EB\u306A\u732B\u3060\u3068\u307F\u3093\u306A\u304C\u8A00\u3046\u3002\u672C\u4EBA\u3082\u3046\u306A\u305A\u304D\u3001\u306A\u3067\u306A\u3067\u306B\u4E00\u756A\u8FD1\u3044\u5834\u6240\u3078\u305D\u3063\u3068\u79FB\u52D5\u3057\u305F\u3002\u30AF\u30FC\u30EB\u306A\u307E\u307E\u3067\u3002"
  - "<b>Kipfel</b>\n\u30D0\u30B2\u30C3\u30C8\u306F\u6E96\u5099\u4E07\u7AEF\u3002\u304A\u663C\u3054\u98EF\u306B\u3059\u308B\u304B\u8FD1\u63A5\u6B66\u5668\u306B\u3059\u308B\u304B\u3001\u307E\u3060\u6C7A\u3081\u3066\u3044\u306A\u3044\u3002\u93E1\u306E\u524D\u306F\u4ECA\u65E5\u3082\u306B\u304E\u3084\u304B\u306B\u306A\u308A\u305D\u3046\u3002"
  - "<b>Kokoa</b>\n\u8B0E\u306E\u30D5\u30EC\u30F3\u30C9\u304C\u30AA\u30F3\u30E9\u30A4\u30F3\u306A\u306E\u306B\u3001\u306A\u304B\u306A\u304B\u90E8\u5C4B\u3078\u6765\u306A\u3044\u3002\u6C17\u306B\u3057\u306A\u3044\u3075\u308A\u3067\u3001\u5165\u53E3\u3092\u516B\u767E\u56DE\u898B\u3066\u3044\u308B\u3002"
  - "<b>Minahoshi</b>\n\u5165\u5BA4\u524D\u304B\u3089\u306A\u3067\u306A\u3067\u306E\u5217\u304C\u3067\u304D\u3066\u3044\u308B\u3002\u5BDD\u305F\u3075\u308A\u3092\u3057\u305F\u3089\u81EA\u5DF1\u7D39\u4ECB\u3092\u7701\u7565\u3067\u304D\u308B\u304B\u306A\uFF1F"
  - "<b>Koyuki</b>\n\u3053\u306E\u8863\u88C5\u3092\u76F4\u3057\u305F\u3089\u5BDD\u308B\u3002\u305D\u308C\u3092\u8A00\u3046\u306E\u306F\u4E09\u6669\u76EE\u3002\u93E1\u306E\u524D\u3067\u3001\u6700\u5F8C\u306B\u8A66\u3057\u305F\u3044\u8272\u304C\u307E\u305F\u898B\u3064\u304B\u3063\u305F\u3002"
  - "<b>Photica</b>\n\u4ECA\u591C\u306E\u4E3B\u5F79\u3060\u3068\u5BA3\u8A00\u3057\u305F\u3002\u5199\u771F\u306F\u307E\u3060\u3060\u3068\u8A00\u308F\u308C\u3066\u3082\u3001\u307E\u305A\u771F\u3093\u4E2D\u3092\u53D6\u3063\u3066\u304A\u3051\u3070\u3044\u3044\u3002"
  - "<b>Maya</b>\n\u53CB\u9054\u306F\u7740\u66FF\u3048\u305F\u3089\u3059\u3050\u6765\u308B\u3068\u8A00\u3063\u305F\u3002\u821E\u591C\u306F\u5199\u771F\u306E\u7ACB\u3061\u4F4D\u7F6E\u3092\u6C7A\u3081\u3066\u5341\u5206\u3001\u8863\u88C5\u3067\u306F\u306A\u304F\u8863\u88C5\u68DA\u3054\u3068\u66FF\u3048\u3066\u3044\u308B\u306E\u304B\u3082\u3002"
  - "<b>MerryMare</b>\n\u8A08\u753B\u306F\u5B8C\u74A7\u3002\u3042\u306A\u305F\u306E\u524D\u3092\u901A\u308A\u3001\u6C17\u3065\u304B\u306A\u3044\u3075\u308A\u3092\u3057\u3066\u3001\u3082\u3046\u4E00\u5EA6\u901A\u308B\u3002\u305F\u3060\u3044\u307E\u56DB\u5468\u76EE\u3002"
  - "\u4F55\u304C\u8D77\u304D\u305F\u304B\u77E5\u3089\u306A\u3044\u3046\u3061\u306B\u3001\u60B2\u3057\u3044\u30D0\u30A4\u30AA\u30EA\u30F3\u304C\u59CB\u307E\u3063\u305F\u3002\u3042\u306A\u305F\u304C\u5238\u3092\u6301\u3064\u3060\u3051\u3067\u3001\u3082\u3046\u8010\u3048\u3089\u308C\u306A\u3044\u9854\u3092\u7528\u610F\u3057\u305F\u3002"
  - "\u30AA\u30FC\u30D6\u306F\u56DE\u308A\u3001\u722A\u6D3E\u306F\u4F1A\u8B70\u4E2D\u3002\u8A08\u7B97\u6A5F\u306F\u52B9\u7387\u3092\u898B\u308D\u3068\u8A00\u3046\u304C\u3001\u5FC3\u306E\u300CClaw
    is law\u300D\u306F\u307E\u305A\u722A\u3092\u53D6\u308C\u3068\u8A00\u3046\u3002"
  - "\u6700\u5F8C\u307E\u3067\u30C1\u30B1\u30C3\u30C8\u306E\u88CF\u306B\u6B8B\u3063\u305F\u4EBA\u304C\u8CDE\u91D1\u7372\u5F97\u3002\u30AB\u30E1\u30E9\u306F\u3053\u3053\u3092\u5411\u3044\u3066\u3044\u308B\u3002\u7AF6\u6280\u4F1A\u5834\u3092\u958B\u304F\u306E\u306F\u3042\u306A\u305F\u3002"
  - "\u96A3\u3067\u306F\u30CF\u30C3\u30D4\u30FC\u306A\u66F2\u304C\u6D41\u308C\u3066\u3044\u308B\u304C\u3001\u30D0\u30CA\u30CA\u732B\u306F\u6CE3\u304F\u6E96\u5099\u6E08\u307F\u3002\u7D50\u679C\u3092\u898B\u308B\u524D\u306B\u3001\u306F\u305A\u308C\u5238\u5168\u90E8\u306E\u5206\u307E\u3067\u6CE3\u3044\u3066\u3057\u307E\u3063\u305F\u3002"
  - "\u93E1\u306E\u9685\u306F\u672C\u65E5\u4F11\u696D\u3001\u3068\u6700\u521D\u306B\u5EA7\u3063\u305FRusk\u3002\u30B9\u30BF\u30C3\u30D5\u306A\u306E\u3067\u5EA7\u308A\u5FC3\u5730\u3092\u78BA\u8A8D\u3057\u306A\u3044\u3068\u3044\u3051\u306A\u3044\u3089\u3057\u3044\u3002"
  - "\u914D\u4FE1\u306F\u76DB\u308A\u4E0A\u304C\u3063\u3066\u3044\u308B\u304C\u3001Speed\u306F\u307E\u3060\u7D50\u679C\u3092\u77E5\u3089\u306A\u3044\u3002\u559C\u3076\u3068\u304D\u3001\u30DE\u30A4\u30AF\u306B\u306F\u3042\u307E\u308A\u512A\u3057\u304F\u306A\u3044\u306E\u3067\u5FC3\u306E\u6E96\u5099\u3092\u3002"
  - "<b>Moe</b>\n\u898B\u308B\u3060\u3051\u3001\u65B0\u3057\u3044\u8863\u88C5\u306F\u8CB7\u308F\u306A\u3044\u3002\u93E1\u306E\u840C\u306F\u3046\u306A\u305A\u3044\u305F\u304C\u3001\u30AB\u30FC\u30C8\u306E\u840C\u306F\u4F55\u3082\u8A00\u308F\u306A\u304B\u3063\u305F\u3002"
  - "\u53E3\u3092\u958B\u3051\u9589\u3081\u3057\u3066\u3001\u3082\u3046\u4F55\u5EA6\u3082\u30AF\u30EA\u30C3\u30AF\u3057\u305F\u3002\u4E16\u754C\u30E9\u30F3\u30AD\u30F3\u30B0\u306F\u9811\u5F35\u308C\u3066\u3082\u3001\u7D50\u679C\u3092\u958B\u304F\u306E\u306F\u3042\u306A\u305F\u306E\u4ED5\u4E8B\u3002"
  - "<b>Airi</b>\n\u4ECA\u65E5\u306F\u5199\u771F\u3092\u64AE\u3089\u306A\u3044\u3068\u8A00\u3063\u305F\u611B\u8389\u3002\u53CB\u9054\u304C\u30AB\u30E1\u30E9\u3092\u6301\u3064\u3068\u3001\u3082\u3046\u5149\u306E\u4E00\u756A\u304D\u308C\u3044\u306A\u5834\u6240\u306B\u7ACB\u3063\u3066\u3044\u305F\u3002"
  - "\u307E\u3060\u8AB0\u3082\u898B\u3066\u3044\u306A\u3044\u8863\u88C5\u3067\u5165\u5BA4\u3002\u305D\u3053\u306B\u306F\u540C\u3058\u8863\u88C5\u306E\u53CB\u9054\u304C\u4E09\u4EBA\u3002\u3055\u3066\u3001\u771F\u3093\u4E2D\u306F\u8AB0\u306E\u3082\u306E\uFF1F"
  - "\u9759\u304B\u306B\u5C11\u3057\u5EA7\u308B\u3060\u3051\u3002\u901A\u308A\u3059\u304C\u308A\u306E\u53CB\u9054\u306B\u306A\u3067\u3089\u308C\u3066\u3001\u305D\u306E\u5C11\u3057\u3092\u671D\u307E\u3067\u5EF6\u9577\u3057\u305F\u3002"
  - "\u96C6\u5408\u5199\u771F\u306F\u3042\u3068\u4E00\u4EBA\u3002\u30B7\u30E7\u30B3\u30E9\u3082\u805E\u3044\u3066\u3044\u308B\u3051\u308C\u3069\u3001\u4E00\u756A\u306B\u304E\u3084\u304B\u306A\u77AC\u9593\u307E\u3067\u5165\u5834\u3092\u3068\u3063\u3066\u304A\u3044\u305F\u3002"
  - "\u3069\u306E\u30C1\u30B1\u30C3\u30C8\u304C\u5F53\u305F\u308A\u3084\u3059\u3044\u304B\u3001\u307F\u3093\u306A\u304C\u8B70\u8AD6\u4E2D\u3002\u5F7C\u306F\u9759\u304B\u306B\u3046\u306A\u305A\u304F\u3060\u3051\u3002\u305D\u306E\u4F59\u88D5\u306B\u8B70\u8AD6\u306E\u8A00\u8449\u304C\u6B62\u307E\u3063\u305F\u3002"
